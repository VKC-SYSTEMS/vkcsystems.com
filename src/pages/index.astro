---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import workshopImg from "../assets/technician-communication-cabinet-workshop.jpg";
import logoMta from "../assets/logo-mta.png";
import logoNyct from "../assets/logo-nyct.png";
import logoLirr from "../assets/logo-lirr.png";
import logoTbta from "../assets/logo-tbta.png";
import logoMetroNorth from "../assets/logo-metro-north.png";
import logoNjTransit from "../assets/logo-nj-transit.png";
import logoPortAuthority from "../assets/logo-port-authority.png";
import logoNycDep from "../assets/logo-nyc-dep.png";
import { capabilityGroups } from "../data/capabilities";
import { featuredProjects, projectAnchor } from "../data/projects";
import { euci, qualificationsPath, teamCredentials } from "../data/qualifications";

const capabilityStatementPdf = "/VKC-Systems-Infrastructure-Capabilities-Statement.pdf";
const homeProjects = featuredProjects.filter((project) => project.homeCard);

const agencies = [
  { name: "MTA", fullName: "Metropolitan Transportation Authority", logo: logoMta },
  { name: "NYCT", fullName: "New York City Transit", logo: logoNyct },
  { name: "LIRR", fullName: "Long Island Rail Road", logo: logoLirr },
  { name: "TBTA", fullName: "Triborough Bridge & Tunnel Authority", logo: logoTbta },
  { name: "Metro-North", fullName: "Metro-North Railroad", logo: logoMetroNorth },
  { name: "NJT", fullName: "New Jersey Transit", logo: logoNjTransit },
  { name: "Port Authority", fullName: "Port Authority of NY & NJ", logo: logoPortAuthority },
  { name: "NYC DEP", fullName: "NYC Dept. of Environmental Protection", logo: logoNycDep },
];

const faqs = [
  {
    question: "What services does VKC Systems provide?",
    answer: "VKC Systems is a systems integrator providing CCTV and video surveillance, access control, public address and intercom, fiber optic and network infrastructure, VoIP phone systems, custom communication cabinet fabrication, CADD documentation, and managed IT services for commercial, transit, and public-sector clients.",
  },
  {
    question: "What areas does VKC Systems serve?",
    answer: "VKC Systems is headquartered in South Hackensack, New Jersey, and serves clients throughout the New York metropolitan area and the surrounding tri-state region.",
  },
  {
    question: "Is VKC Systems a certified MBE/DBE contractor?",
    answer: "Yes. VKC Systems is a certified Minority Business Enterprise (MBE) and Disadvantaged Business Enterprise (DBE), and qualifies for MTA's Enhanced Utilization Credit Initiative (EUCI) Pilot Program. Credentials held by members of our team include BICSI RCDD, AVIXA CTS and CTS-I, FOA CFOT, PMI PMP, Cisco CCNA and CCNP, CompTIA Network+, CSPM, OSHA 30, Track Safety Training, and SWAC.",
  },
  {
    question: "What public-sector agencies has VKC Systems worked with?",
    answer: "VKC Systems has supported projects for the MTA, New York City Transit, Long Island Rail Road, Triborough Bridge & Tunnel Authority, Metro-North Railroad, NJ Transit, the Port Authority of NY & NJ, and the NYC Department of Environmental Protection.",
  },
  {
    question: "How do I request a project consultation or quote from VKC Systems?",
    answer: "Submit a project inquiry through the contact form at vkcsystems.com/contact, email info@vkcsystems.com, or call (201) 374-0252. Office hours are Monday through Friday, 7:00 AM to 3:00 PM Eastern. Typical response time is within one business day.",
  },
];
---

<BaseLayout
  title="VKC Systems | Transit & Infrastructure Integrator"
  description="MBE/DBE systems integrator for CCTV, access control, networking, and communication systems. Serving NYCT, MTA, NJ Transit, and agencies in the NYC metro area."
  faqs={faqs}
>
  <!-- ============================================ -->
  <!--                    HERO                      -->
  <!-- ============================================ -->
  <section class="relative overflow-hidden bg-vkc-dark text-white">
    <!-- Faint drafting grid behind the copy -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.07]"
      style="background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px); background-size: 48px 48px;"
      aria-hidden="true"
    ></div>

    <div class="mx-auto max-w-7xl lg:flex lg:min-h-[36rem] lg:items-center">
      <div class="relative z-10 flex flex-col justify-center px-4 py-10 sm:px-6 sm:py-16 lg:w-1/2 lg:py-20 lg:pr-10 lg:pl-8">
        <p class="flex items-center gap-3 text-xs font-semibold tracking-widest text-vkc-red-light uppercase">
          <span class="h-px w-8 bg-vkc-red" aria-hidden="true"></span>
          MBE/DBE Certified Systems Integrator
        </p>
        <h1 class="mt-5 text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl">
          Integrated Systems.
          <span class="block text-vkc-red">Critical Infrastructure.</span>
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-zinc-300 sm:text-lg">
          VKC Systems engineers, fabricates, and integrates communications systems for transit
          and public infrastructure projects.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            href="/projects"
            class="inline-flex items-center justify-center rounded-md bg-vkc-red px-7 py-3 text-sm font-semibold text-white transition hover:bg-vkc-red-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-vkc-dark"
          >
            Explore Our Work
          </a>
          <a
            href="/contact#bid"
            class="inline-flex items-center justify-center rounded-md border border-zinc-400 px-7 py-3 text-sm font-semibold text-white transition hover:border-white hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-vkc-dark"
          >
            Invite VKC to Bid
          </a>
        </div>
        <a
          href={capabilityStatementPdf}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex w-fit items-center gap-2 text-sm text-zinc-300 underline decoration-zinc-500 underline-offset-4 transition hover:text-white hover:decoration-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          Capability statement (PDF)
          <span class="sr-only">, opens in a new tab</span>
        </a>
      </div>

      <figure class="relative aspect-[16/10] lg:absolute lg:inset-y-0 lg:right-0 lg:aspect-auto lg:w-1/2">
        <img
          src="/projects/aw-73.jpg"
          alt="Traffic entering the Hugh L. Carey Tunnel portal in Manhattan"
          width="1024"
          height="768"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover object-[30%_50%]"
        />
        <!-- Blend the photo into the charcoal panel on wide screens -->
        <div class="absolute inset-y-0 left-0 hidden w-24 bg-gradient-to-r from-vkc-dark to-transparent lg:block" aria-hidden="true"></div>
        <figcaption class="absolute right-3 bottom-3 rounded bg-black/70 px-2 py-1 text-xs text-white">
          Hugh L. Carey Tunnel, New York
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============================================ -->
  <!--              AGENCY LOGO STRIP               -->
  <!-- ============================================ -->
  <section class="border-b border-zinc-200 bg-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:flex-row lg:items-center lg:gap-10 lg:px-8">
      <p class="shrink-0 text-xs font-semibold tracking-widest text-vkc-gray uppercase">Supporting projects for</p>
      <ul class="grid flex-1 grid-cols-4 items-center gap-x-6 gap-y-5 sm:grid-cols-8">
        {agencies.map((agency) => (
          <li class="flex h-10 items-center justify-center">
            <Image
              src={agency.logo}
              alt={agency.fullName}
              title={agency.fullName}
              class="max-h-10 w-auto max-w-full object-contain"
              width={agency.name === "MTA" ? 40 : 120}
              quality={80}
              format="webp"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================================ -->
  <!--               INTRODUCTION                   -->
  <!-- ============================================ -->
  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 md:grid-cols-12 lg:gap-16 lg:px-8">
      <figure class="relative overflow-hidden rounded-lg md:col-span-5">
        <Image
          src={workshopImg}
          alt="Technician working on an open communication cabinet with rack-mounted network switches and blue patch cables in a workshop"
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 40vw, 100vw"
          quality={80}
          format="webp"
          loading="lazy"
          class="aspect-square w-full object-cover object-[50%_30%] sm:aspect-[5/4] md:aspect-[4/5] md:object-center"
        />
        <figcaption class="absolute bottom-3 left-3 rounded bg-black/70 px-2 py-1 text-xs text-white">
          Digitally retouched image
        </figcaption>
      </figure>
      <div class="md:col-span-7">
        <p class="text-sm font-semibold tracking-widest text-vkc-red uppercase">About VKC</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl">
          Engineering expertise. Hands-on execution.
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-vkc-gray">
          Founded in 2014 and headquartered in South Hackensack, New Jersey, VKC Systems is a
          systems integrator for transit and public infrastructure projects. We work with general
          contractors and agencies from field survey and engineering through cabinet fabrication,
          testing, and closeout documentation.
        </p>
        <a href="/about" class="mt-6 inline-flex items-center text-sm font-semibold text-vkc-red transition hover:text-vkc-red-dark">
          About VKC Systems &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!--               CAPABILITIES                   -->
  <!-- ============================================ -->
  <section class="bg-vkc-light py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold tracking-widest text-vkc-red-dark uppercase">Capabilities</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl">What we deliver</h2>
        </div>
        <a href="/solutions" class="text-sm font-semibold text-vkc-red-dark transition hover:text-vkc-dark">All capabilities &rarr;</a>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-zinc-200 bg-zinc-200 sm:grid-cols-2 lg:grid-cols-4">
        {capabilityGroups.map((group, index) => (
          <a
            href={`/solutions#${group.id}`}
            class="group relative flex flex-col bg-white p-6 transition hover:bg-zinc-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-vkc-red sm:p-8"
          >
            <span class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-vkc-red transition-transform duration-300 group-hover:scale-x-100" aria-hidden="true"></span>
            <span class="font-mono text-sm font-semibold text-vkc-red">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="mt-4 text-lg font-bold leading-snug text-zinc-900">{group.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-vkc-gray">{group.teaser}</p>
            <span class="mt-auto pt-6 text-sm font-semibold text-vkc-red">
              Learn more<span class="sr-only"> about {group.title}</span> &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!--               PROJECT CARDS                  -->
  <!-- ============================================ -->
  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold tracking-widest text-vkc-red uppercase">Project Experience</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl">Selected work</h2>
        </div>
        <a href="/projects" class="text-sm font-semibold text-vkc-red transition hover:text-vkc-red-dark">All projects &rarr;</a>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3">
        {homeProjects.map((project) => (
          <article class="group flex flex-col">
            <div class="relative aspect-[4/3] overflow-hidden rounded-lg bg-zinc-100">
              <img
                src={project.image}
                alt={project.imageAlt}
                loading="lazy"
                class="h-full w-full object-cover object-center transition duration-500 group-hover:scale-[1.03]"
              />
              {project.imageLabel && (
                <span class="absolute bottom-3 left-3 right-3 w-fit rounded bg-black/75 px-2 py-1 text-xs font-medium text-white">
                  {project.imageLabel}
                </span>
              )}
            </div>
            <p class="mt-5 text-xs font-bold tracking-wider text-vkc-red uppercase">{project.agency} {project.id}</p>
            <h3 class="mt-2 text-xl font-bold leading-snug text-zinc-900">{project.homeCard!.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-vkc-gray">{project.homeCard!.role}</p>
            <a
              href={`/projects#${projectAnchor(project.id)}`}
              class="mt-4 text-sm font-semibold text-vkc-red transition hover:text-vkc-red-dark"
            >
              View project<span class="sr-only"> {project.id}</span> &rarr;
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!--                    FAQ                       -->
  <!-- ============================================ -->
  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="lg:col-span-4">
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl">Common questions</h2>
        <p class="mt-3 text-sm leading-relaxed text-vkc-gray">
          Something else? Call <a href="tel:2013740252" class="font-semibold text-vkc-dark hover:text-vkc-red">(201) 374-0252</a>.
        </p>
      </div>
      <div class="divide-y divide-zinc-200 border-y border-zinc-200 lg:col-span-8">
        {faqs.map((faq) => (
          <details class="group py-4 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-left">
              <h3 class="text-base font-semibold text-zinc-900">{faq.question}</h3>
              <svg class="h-5 w-5 shrink-0 text-vkc-gray transition-transform duration-200 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </summary>
            <p class="mt-3 pr-8 text-sm leading-relaxed text-vkc-gray">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!--               QUALIFICATIONS                 -->
  <!-- ============================================ -->
  <!-- Company qualifications and team credentials stay in separate columns:
       the first belong to VKC, the second to individual team members. -->
  <section class="bg-vkc-dark py-14 text-white sm:py-16" aria-labelledby="qualifications-heading">
    <h2 id="qualifications-heading" class="sr-only">Qualifications</h2>
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:gap-12 lg:px-8">
      <div class="lg:col-span-7">
        <h3 class="text-xs font-semibold tracking-widest text-zinc-300 uppercase">Company qualifications</h3>
        <dl class="mt-5 grid grid-cols-2 gap-6 sm:grid-cols-3">
          <div class="border-l-2 border-vkc-red pl-4">
            <dt class="text-xs font-semibold tracking-widest text-zinc-300 uppercase">Founded</dt>
            <dd class="mt-1 text-2xl font-bold sm:text-3xl">2014</dd>
          </div>
          <div class="border-l-2 border-vkc-red pl-4">
            <dt class="text-xs font-semibold tracking-widest text-zinc-300 uppercase">Certified</dt>
            <dd class="mt-1 text-2xl font-bold sm:text-3xl">MBE/DBE</dd>
          </div>
          <div class="col-span-2 border-l-2 border-vkc-red pl-4 sm:col-span-1">
            <dt class="text-xs font-semibold tracking-widest text-zinc-300 uppercase">Program</dt>
            <dd class="mt-1 text-lg font-bold leading-tight sm:text-xl">{euci.label}</dd>
          </div>
        </dl>
        <p class="mt-6 max-w-2xl text-sm leading-relaxed text-zinc-300">{euci.summary}</p>
        <a
          href={euci.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-vkc-red-light underline-offset-4 transition hover:text-white hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          {euci.linkLabel}<span class="sr-only"> (mta.info, opens in a new tab)</span> &rarr;
        </a>
      </div>
      <div class="border-t border-white/10 pt-8 lg:col-span-5 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-12">
        <h3 class="text-xs font-semibold tracking-widest text-zinc-300 uppercase">Team Credentials</h3>
        <p class="mt-2 text-sm text-zinc-300">Held by members of the VKC team.</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {teamCredentials.map((credential) => (
            <li class="rounded border border-white/15 px-3 py-1.5 text-sm text-zinc-100">
              {credential.name}
              {credential.about && <span class="block text-xs text-zinc-300">{credential.title}</span>}
            </li>
          ))}
        </ul>
        <a
          href={capabilityStatementPdf}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-vkc-red-light transition hover:text-white"
        >
          Capability statement (PDF) &rarr;
        </a>
      </div>
      <a
        href={qualificationsPath}
        class="inline-flex w-fit items-center text-sm font-semibold text-white underline decoration-white/40 underline-offset-4 transition hover:decoration-white lg:col-span-12"
      >
        All qualifications and team credentials &rarr;
      </a>
    </div>
  </section>

  <!-- ============================================ -->
  <!--                  CONTACT                     -->
  <!-- ============================================ -->
  <section class="bg-vkc-red text-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-12 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
      <div>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Let’s discuss your next project.</h2>
        <p class="mt-2 text-base text-white">Send us the details and bid date. We typically respond within one business day.</p>
      </div>
      <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
        <a
          href="/contact#bid"
          class="inline-flex items-center justify-center rounded-md bg-white px-7 py-3 text-sm font-semibold text-vkc-red-dark transition hover:bg-zinc-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-vkc-red"
        >
          Invite VKC to Bid
        </a>
        <a
          href="tel:2013740252"
          class="inline-flex items-center justify-center rounded-md border border-white/70 px-7 py-3 text-sm font-semibold text-white transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          Call (201) 374-0252
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
