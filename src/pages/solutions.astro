---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { capabilityGroups, commercialGroup } from '../data/capabilities';
import { serviceIcons, solutionByHref } from '../data/solutions';
---

<BaseLayout
  title="Solutions | Networking, CCTV & More | VKC Systems"
  description="Explore VKC Systems' IT solutions: networking, CCTV, public address, access control, communication cabinets, CADD, VoIP, and managed office IT."
>
  <!-- Hero Section -->
  <section class="relative bg-vkc-dark py-24 sm:py-32">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-vkc-dark via-gray-900 to-vkc-dark"></div>
      <div class="absolute top-0 right-0 h-96 w-96 rounded-full bg-vkc-red/5 blur-3xl"></div>
      <div class="absolute bottom-0 left-0 h-96 w-96 rounded-full bg-vkc-red/5 blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-vkc-red-light">What We Do</p>
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Our Capabilities
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-300 sm:text-xl">
        VKC Systems provides systems integration, communication infrastructure, and low-voltage capabilities for transit, government, and commercial projects.
      </p>
    </div>
  </section>

  <!-- Capability Groups -->
  {capabilityGroups.map((group, index) => (
    <section id={group.id} class:list={['scroll-mt-24 py-16 sm:py-20', index % 2 === 0 ? 'bg-white' : 'bg-vkc-light']}>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-5">
          <div class="lg:col-span-2">
            <p class="text-sm font-bold text-vkc-red-dark">{String(index + 1).padStart(2, '0')}</p>
            <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-vkc-dark sm:text-3xl">{group.title}</h2>
            <p class="mt-3 text-base leading-relaxed text-vkc-gray">{group.summary}</p>
          </div>
          <ul class="grid grid-cols-1 gap-x-6 gap-y-3 self-center sm:grid-cols-2 lg:col-span-3">
            {group.deliverables.map((item) => (
              <li class="flex items-start gap-2 text-sm leading-relaxed text-vkc-dark">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-vkc-red" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        {group.pages.length > 0 && (
          <div class="mt-10 grid gap-8 md:grid-cols-2">
            {group.pages.map((href) => {
              const solution = solutionByHref[href];
              return (
              <a
                href={solution.href}
                class="group relative flex flex-col rounded-2xl border border-gray-100 bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-xl hover:border-vkc-red/20 hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vkc-red focus-visible:ring-offset-2"
              >
                <div class="mb-6 h-28 w-28 overflow-hidden rounded-xl">
                  <Image src={serviceIcons[solution.title]} alt="" class="h-full w-full object-cover" width={112} quality={80} format="webp" />
                </div>
                <h3 class="mb-3 text-xl font-bold text-vkc-dark group-hover:text-vkc-dark transition-colors duration-200">
                  {solution.title}
                </h3>
                <p class="mb-6 text-base leading-relaxed text-vkc-gray">
                  {solution.description}
                </p>
                <ul class="mb-6 grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">
                  {solution.subServices.map((sub) => (
                    <li class="flex items-start gap-2 text-sm text-vkc-gray">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-vkc-red" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                      </svg>
                      {sub}
                    </li>
                  ))}
                </ul>
                <div class="mt-auto">
                  <span class="inline-flex items-center text-sm font-semibold text-vkc-red-dark transition-all duration-200 group-hover:gap-2">
                    Learn More
                    <svg class="ml-1 h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                  </span>
                </div>
              </a>
              );
            })}
          </div>
        )}

        {group.relatedPages && (
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <span class="text-sm font-medium text-vkc-gray">Testing is part of the scope on:</span>
            {group.relatedPages.map((href) => (
              <a
                href={href}
                class="rounded-full border border-gray-300 bg-white px-4 py-1.5 text-sm font-semibold text-vkc-dark transition hover:border-vkc-red hover:text-vkc-red focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vkc-red"
              >
                {solutionByHref[href].title} &rarr;
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <!-- Secondary: Commercial IT & VoIP -->
  <section id={commercialGroup.id} class="scroll-mt-24 border-t border-gray-200 bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-vkc-gray">Commercial Services</p>
        <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-vkc-dark sm:text-3xl">{commercialGroup.title}</h2>
        <p class="mt-3 text-base leading-relaxed text-vkc-gray">{commercialGroup.summary}</p>
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {commercialGroup.pages.map((href) => {
          const solution = solutionByHref[href];
          return (
              <a
                href={solution.href}
                class="group relative flex flex-col rounded-2xl border border-gray-100 bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-xl hover:border-vkc-red/20 hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vkc-red focus-visible:ring-offset-2"
              >
                <div class="mb-6 h-28 w-28 overflow-hidden rounded-xl">
                  <Image src={serviceIcons[solution.title]} alt="" class="h-full w-full object-cover" width={112} quality={80} format="webp" />
                </div>
                <h3 class="mb-3 text-xl font-bold text-vkc-dark group-hover:text-vkc-red transition-colors duration-200">
                  {solution.title}
                </h3>
                <p class="mb-6 text-base leading-relaxed text-vkc-gray">
                  {solution.description}
                </p>
                <ul class="mb-6 grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">
                  {solution.subServices.map((sub) => (
                    <li class="flex items-start gap-2 text-sm text-vkc-gray">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-vkc-red" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                      </svg>
                      {sub}
                    </li>
                  ))}
                </ul>
                <div class="mt-auto">
                  <span class="inline-flex items-center text-sm font-semibold text-vkc-red transition-all duration-200 group-hover:gap-2">
                    Learn More
                    <svg class="ml-1 h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                  </span>
                </div>
              </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <!-- Capability Statement -->
  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold tracking-tight text-vkc-dark sm:text-3xl">
        Download Our Capabilities Statement
      </h2>
      <p class="mt-3 text-base leading-relaxed text-vkc-gray">
        Gain an overview of VKC Systems' engineering capabilities, infrastructure experience, and certifications.
      </p>
      <ul class="mt-5 inline-flex flex-col items-start gap-2 text-sm text-vkc-gray">
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-vkc-red flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          Core infrastructure capabilities
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-vkc-red flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          MBE / DBE certifications
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-vkc-red flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          Relevant project experience
        </li>
      </ul>
      <div class="mt-6">
        <a
          href="/VKC-Systems-Infrastructure-Capabilities-Statement.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md bg-vkc-red px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:bg-vkc-red-dark focus:outline-none focus:ring-2 focus:ring-vkc-red focus:ring-offset-2"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          Download Capabilities Statement (PDF)
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-vkc-light py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold tracking-tight text-vkc-dark sm:text-4xl">
        Ready to discuss your project?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-vkc-gray">
        Our team of engineers and technical experts is ready to help you find the right solution for your needs.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/contact"
          class="inline-flex items-center rounded-lg bg-vkc-red px-8 py-3.5 text-base font-semibold text-white shadow-sm transition-colors duration-200 hover:bg-vkc-red-dark"
        >
          Request a Project Consultation
        </a>
        <a
          href="/projects"
          class="inline-flex items-center rounded-lg border-2 border-vkc-dark px-8 py-3.5 text-base font-semibold text-vkc-dark transition-colors duration-200 hover:bg-vkc-dark hover:text-white"
        >
          View Our Projects
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
